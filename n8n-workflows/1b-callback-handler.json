      "name": "Match Target Row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        20,
        364
      ],
      "parameters": {
        "jsCode": "const p = $('Parse Vinted Link').first().json;\nconst rows = $input.all().map(r => r.json).filter(r => r['FB ID']);\nlet target = null;\nif (p.refFbId) target = rows.find(r => String(r['FB ID']).trim() === p.refFbId);\nif (!target && p.refTitle) target = rows.find(r => String(r.Title || '').trim() === p.refTitle);\nif (!target) {\n  const cand = rows.filter(r => String(r.Status || '').trim() === 'Approved' && !String(r['Vinted ID'] || '').trim());\n  target = cand[cand.length - 1];\n}\nif (!target) return [{ json: { found: 'no', chatId: p.chatId } }];\nreturn [{ json: { found: 'yes', chatId: p.chatId, fbId: String(target['FB ID']),\n  title: String(target.Title || ''), vintedId: p.vintedId, vintedUrl: p.vintedUrl } }];"
      }
