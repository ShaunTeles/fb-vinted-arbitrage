    {
      "id": "parse-vlink",
      "name": "Parse Vinted Link",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -520,
        364
      ],
      "parameters": {
        "jsCode": "const u = $('Telegram Trigger').first().json;\nconst msg = u.message;\nif (!msg) return [];\nconst chatId = String((msg.chat && msg.chat.id) || '');\nif (chatId !== String($env.TELEGRAM_CHAT_ID)) return [];\nconst text = msg.text || '';\nconst idMatch = text.match(/vinted\\.[a-z.]+\\/items\\/(\\d+)/i);\nif (!idMatch) return [{ json: { mode: 'help', chatId } }];\nconst vintedId = idMatch[1];\nconst urlMatch = text.match(/https?:\\/\\/\\S*vinted\\.[a-z.]+\\/items\\/\\d+\\S*/i);\nconst vintedUrl = urlMatch ? urlMatch[0].replace(/^http(s)?:\\/\\//i, 'https://') : ('https://www.vinted.cz/items/' + vintedId);\nlet refFbId = '', refTitle = '';\nconst rt = (msg.reply_to_message && msg.reply_to_message.text) || '';\nconst refMatch = rt.match(/Ref: (\\S+)/);\nif (refMatch) {\n  refFbId = refMatch[1];\n} else {\n  const lines = rt.split('\\n');\n  const i = lines.findIndex(l => l.indexOf('Title') >= 0 && l.indexOf('\\u{1F4CC}') >= 0 || l.trim() === '\\u{1F4CC} Title');\n  if (i >= 0 && lines[i+1]) refTitle = lines[i+1].trim();\n}\nreturn [{ json: { mode: 'file', chatId, vintedId, vintedUrl, refFbId, refTitle } }];"
      }
    },
