        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $env.TELEGRAM_CHAT_ID, parse_mode: 'HTML', text: '🎉 <b>SOLD on Vinted!</b>\\n\\n📦 ' + String($('Merge Data').first().json.title).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;') + '\\n💰 Sale price: <b>' + $('Merge Data').first().json.salePrice + ' CZK</b>\\n📈 Profit: <b>' + $('Merge Data').first().json.profit + ' CZK</b>' + '\\n\\n<b>Is the FB listing still available?</b>\\n🔗 <a href=\"' + $('Merge Data').first().json.fbUrl + '\">Check FB listing</a>', reply_markup: { inline_keyboard: [[ { text: '✅ Still listed - message seller', callback_data: 'fb_active:' + $('Merge Data').first().json.vintedId }, { text: '❌ No longer listed', callback_data: 'fb_gone:' + $('Merge Data').first().json.vintedId } ]] } }) }}",
        "options": {}
      },
