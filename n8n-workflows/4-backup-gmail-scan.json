      "id": "cc61e3c1-61a7-4d70-aae5-1bae761e3196",
      "name": "Search Vinted Sale Emails",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        -448,
        112
      ],
      "webhookId": "73371af5-ff36-4a4b-9a38-35b42e275c72",
      "credentials": {
        "gmailOAuth2": {
          "id": "CudzfvUbpaxGLmzF",
          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "check-emails-exist",
              "leftValue": "={{ $input.all().length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "78fb106e-0d7f-4504-9f74-61caced234fa",
      "name": "Any Emails Found?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -224,
        112
      ]
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "379a5435-752c-4a55-af25-162c89852d97",
      "name": "Process One at a Time",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = [];\nconst emails = Array.isArray($input.all()) ? $input.all() : [$input.first()];\nfor (const email of emails) {\n  const subject = email.json.subject || '';\n  const snippet = email.json.snippet || '';\n  const body = email.json.text || email.json.html || '';\n\n  // Try to extract item title from subject (Vinted subjects are like \"Tvůj item 'TITLE' byl prodán\")\n  const titleMatch = subject.match(/'([^']+)'/) || subject.match(/\"([^\"]+)\"/);\n  const title = titleMatch ? titleMatch[1] : snippet.substring(0, 60);\n\n  // Try to extract price from body/snippet\n  const priceMatch = (body + snippet).match(/(\\d+)\\s*(?:Kč|CZK|czk|kč)/i);\n  const salePrice = priceMatch ? parseInt(priceMatch[1]) : 0;\n\n  // Try to extract Vinted item ID from email links\n  const vintedIdMatch = (body + snippet).match(/vinted\\.cz\\/items\\/(\\d+)/);\n  const vintedId = vintedIdMatch ? vintedIdMatch[1] : '';\n\n  \n  // GUARD: only process genuine sale emails — must have a Vinted item ID\n  // (prevents newsletters/favorites from matching empty 'Vinted ID' sheet cells)\n  if (!vintedId) continue;\n  items.push({ json: { title, salePrice, vintedId, emailSubject: subject, emailDate: email.json.date || new Date().toISOString() } });\n}\nreturn items;"
      },
      "id": "d07aff22-d315-40d4-9963-58f0a45ada7b",
      "name": "Parse Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ]
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "value": "YOUR_GOOGLE_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Items",
          "mode": "name"
        },
        "filtersUI": {
          "values": [
            {
              "lookupColumn": "Vinted ID",
              "lookupValue": "={{ $json.vintedId }}"
            }
          ]
        },
        "options": {}
      },
      "id": "3fa80a9e-d7a5-4fbb-9181-6789fd835ccc",
      "name": "Find Row by Vinted ID",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.4,
      "position": [
        448,
        0
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "aldYCl67mumuXWzk",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const emailData = $('Parse Email').item.json;\nconst sheetRow = $input.first().json;\nconst fbUrl = sheetRow['FB URL'] || sheetRow['B'] || 'Not found';\nconst title = sheetRow['Title'] || sheetRow['D'] || emailData.title;\nconst fbPrice = sheetRow['FB Price'] || sheetRow['F'] || 0;\nconst vintedPrice = sheetRow['Vinted Price'] || sheetRow['G'] || 0;\nconst profit = emailData.salePrice ? emailData.salePrice - parseInt(fbPrice) : vintedPrice - parseInt(fbPrice);\nreturn [{ json: { title, fbUrl, salePrice: emailData.salePrice, profit, vintedId: emailData.vintedId, fbPrice, vintedPrice, emailData } }];"
      },
      "id": "ec392bcc-0a0f-4e7a-b06a-7a43ef1089fc",
      "name": "Merge Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ]
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": {
          "__rl": true,
          "value": "YOUR_GOOGLE_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Items",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Vinted ID": "={{ $json.vintedId }}",
            "Status": "=Sold",
            "Sale Date": "={{ $now.toISO() }}",
            "Sale Price": "={{ $json.salePrice }}",
            "Profit": "={{ $json.profit }}"
          },
          "matchingColumns": [
            "Vinted ID"
          ],
          "schema": []
        },
        "options": {}
      },
      "id": "65415d74-a762-4504-975c-8e462ce109e8",
      "name": "Update Row as Sold",
