    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "x-api-key",
              "value": "={{ $('Get Secrets').first().json.anthropicKey }}"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-haiku-4-5-20251001\",\n  \"max_tokens\": 256,\n  \"messages\": [{\n    \"role\": \"user\",\n    \"content\": \"You are an arbitrage scoring assistant. Score this Facebook Marketplace kids' clothing listing for resale on Vinted.cz Czech Republic.\\n\\nTitle: {{ $json.title }}\\nPrice: {{ $json.price }} CZK\\nDescription: {{ $json.description }}\\n\\nScore 1-10 based on:\\n1. Is the FB price competitive/good value for what it is?\\n2. Will this item sell quickly on Vinted at {{ $json.price + 600 }} CZK?\\n\\nFast-selling brands: Zara Kids, H&M, Next, Nike, Adidas, Marks & Spencer, Tommy Hilfiger, Boss Baby, Mayoral, Lego Wear, Reima, Columbia, Petit Bateau\\n\\nRespond ONLY with valid JSON:\\n{\\\"score\\\": <1-10>, \\\"reason\\\": \\\"<one sentence>\\\", \\\"brand\\\": \\\"<brand or unknown>\\\", \\\"condition\\\": \\\"<new/very_good/good/fair>\\\", \\\"size\\\": \\\"<size or unknown>\\\"}\"\n  }]\n}",
        "options": {}
      },
      "id": "4c3fb872-dd3e-43ae-8b5b-64d11f674e52",
      "name": "Claude Score Item",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -880,
        128
      ]
    },
    {
      "parameters": {
        "jsCode": "const inputItem = $input.first();\n  let text = inputItem.json.content[0].text.trim();\n\n  // Strip ```json ... ``` fences if Claude wrapped its answer in them\n  if (text.startsWith('```')) {\n    text = text.replace(/^```[a-z]*\\s*/i, '').replace(/```\\s*$/, '').trim();\n  }\n\n  // Fallback: take everything between the first { and the last }\n  if (!text.startsWith('{')) {\n    text = text.slice(text.indexOf('{'), text.lastIndexOf('}') + 1);\n  }\n\n  const parsed = JSON.parse(text);\n\n  // Re-attach the original listing (title, price, id, url...)\n  // that was lost when Claude's API response replaced it\n  const original = $('Loop Through Items').first().json;\n\n  return [{ json: { ...original, ...parsed } }];"
      },
