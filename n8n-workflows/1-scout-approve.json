        "jsonBody": "={{ JSON.stringify({ chat_id: $('Get Secrets').first().json.telegramChatId, photo: $json.images[0], caption: '🛍 <b>' +\n  $json.title + '</b>\\n\\n💰 FB: <b>' + $json.fbPrice + ' CZK</b> → Vinted: <b>' + $json.vintedPrice + ' CZK</b>\\n⭐ Score: ' +\n  $json.score + '/10\\n📝 ' + $json.reason + '\\n🏷 Brand: ' + $json.brand + '\\n📏 Size: ' + $json.size + '\\n📦 Package: ' + ($json.package_size || '?') + '\\n\\n<a href=\"' +\n  $json.fbUrl + '\">View on Facebook</a>', parse_mode: 'HTML', reply_markup: { inline_keyboard: [[ { text: '✅ Approve',\n  callback_data: 'approve:' + $json.fbId }, { text: '❌ Skip', callback_data: 'skip:' + $json.fbId } ]] } }) }}",
