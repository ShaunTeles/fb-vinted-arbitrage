    {
      "id": "normalize-listings",
      "name": "Normalize Listings",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1120,
        -80
      ],
      "parameters": {
        "jsCode": "// Map Apify facebook-marketplace-scraper output to the canonical item shape\nconst out = [];\nfor (const item of $input.all()) {\n  const j = item.json;\n  const photos = (j.listingPhotos || [])\n    .map(p => p && p.image && p.image.uri)\n    .filter(Boolean);\n  if (!photos.length && j.primaryListingPhoto && j.primaryListingPhoto.photo_image_url) {\n    photos.push(j.primaryListingPhoto.photo_image_url);\n  }\n  if (!j.id || !j.listingTitle) continue;\n  out.push({ json: {\n    id: String(j.id),\n    title: j.listingTitle || '',\n    price: Number((j.listingPrice && j.listingPrice.amount) || 0),\n    description: (j.description && j.description.text) || '',\n    url: j.itemUrl || ('https://www.facebook.com/marketplace/item/' + j.id + '/'),\n    images: photos.slice(0, 3),\n    sellerName: ''\n  }});\n}\nreturn out;"
      }
    },
    {
      "id": "get-known-fb-ids",
      "name": "Get Known FB IDs",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.4,
      "position": [
