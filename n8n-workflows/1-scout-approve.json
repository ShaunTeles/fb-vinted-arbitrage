        "jsCode": "// MOCK DATA - replacing Apify scraper for testing\n  return [\n    {\n      json: {\n        id: \"mock-001\",\n        title: \"Zara Kids zimní bunda vel. 104\",\n        price: 350,\n        description: \"Krásná zimní bunda Zara Kids, vel. 104. Velmi dobrý stav, barva modrá.\",\n        url: \"https://www.facebook.com/marketplace/item/mock-001\",\n        images: [\"https://picsum.photos/id/237/400/400.jpg\"],\n        sellerName: \"Jana Novákova\"\n      }\n    },\n    {\n      json: {\n        id: \"mock-002\",\n        title: \"H&M sada oblečení pro miminko 62-68\",\n        price: 200,\n        description: \"Sada 5 kusů oblečení H&M, vel. 62-68. Téměř nové, bez skvrn.\",\n        url: \"https://www.facebook.com/marketplace/item/mock-002\",\n        images: [\"https://picsum.photos/id/1062/400/400.jpg\"],\n        sellerName: \"Petra Svobodová\"\n      }\n    },\n    {\n      json: {\n        id: \"mock-003\",\n        title: \"Nike tenisky dětské vel. 28\",\n        price: 450,\n        description: \"Originální Nike tenisky, vel. 28. Dobrý stav, podrážka neopotřebovaná.\",\n        url: \"https://www.facebook.com/marketplace/item/mock-003\",\n        images: [\"https://picsum.photos/id/1084/400/400.jpg\"],\n        sellerName: \"Martin Dvořák\"\n      }\n    }\n  ];"
