    {
      "id": "filter-new-items",
      "name": "Filter New Items",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -768,
        -80
      ],
      "parameters": {
        "jsCode": "// Drop listings whose FB ID is already in the Google Sheet\nconst listings = $('Normalize Listings').all().map(i => i.json);\nconst known = new Set();\nfor (const row of $input.all()) {\n  const v = row.json['FB ID'];\n  if (v !== undefined && v !== null && String(v).trim() !== '') {\n    known.add(String(v).trim());\n  }\n}\nconst fresh = listings.filter(l => !known.has(String(l.id)));\nreturn fresh.map(j => ({ json: j }));"
      }
    }
