        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({model: \"claude-haiku-4-5-20251001\", max_tokens: 256, messages: [{role: \"user\", content: \"You are an arbitrage scoring assistant. Score this Facebook Marketplace kids' clothing listing for resale on Vinted.cz Czech Republic.\\n\\nTitle: \" + $json.title + \"\\nPrice: \" + $json.price + \" CZK\\nDescription: \" + String($json.description || '').slice(0, 600) + \"\\n\\nScore 1-10 based on:\\n1. Is the FB price competitive/good value for what it is?\\n2. Will this item sell quickly on Vinted at \" + ($json.price + 600) + \" CZK?\\n\\nFast-selling brands: Zara Kids, H&M, Next, Nike, Adidas, Marks & Spencer, Tommy Hilfiger, Boss Baby, Mayoral, Lego Wear, Reima, Columbia, Petit Bateau\\n\\nVinted package size guide: S = fits a large envelope (single clothing item, under 1 kg), M = shoebox size (shoes, small clothing bundles, 1-2 kg), L = larger (big bundles, winter jackets, over 2 kg).\\n\\nRespond ONLY with valid JSON:\\n\" + '{\"score\": <1-10>, \"reason\": \"<one sentence>\", \"brand\": \"<brand or unknown>\", \"condition\": \"<new/very_good/good/fair>\", \"size\": \"<size or unknown>\", \"package_size\": \"<S/M/L>\"}'}]}) }}",
        "options": {}
      },
      "id": "4c3fb872-dd3e-43ae-8b5b-64d11f674e52",
      "name": "Claude Score Item",
